// AutoMantPro — Prisma schema (PostgreSQL)
// Mirror of packages/db/prisma/schema.prisma
// DO NOT MODIFY the original in packages/db

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  dueno
  taller
  almacen
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}

enum OrderType {
  service
  repuesto
}

enum OrderStatus {
  requested
  accepted
  fulfilled
  cancelled
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String    @unique
  passwordHash String
  role         Role
  name         String
  locale       String    @default("es")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  vehicles       Vehicle[]
  shop           Shop?
  store          Store?
  appointments   Appointment[]  @relation("appointment_owner")
  ordersFrom     Order[]        @relation("order_from")
  ordersTo       Order[]        @relation("order_to")
  conversationsA Conversation[] @relation("ConversationUserA")
  conversationsB Conversation[] @relation("ConversationUserB")
  subscriptions  Subscription[]
  transactions   Transaction[]
}

model Vehicle {
  id        String    @id @default(uuid())
  userId    String
  make      String
  model     String
  year      Int
  currentKm Int
  plan      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User              @relation(fields: [userId], references: [id])
  schedules    ServiceSchedule[]
  services     Service[]
  appointments Appointment[]
  alerts       Alert[]
  compat       ProductVehicle[]

  @@index([userId])
}

model ServiceSchedule {
  id         String    @id @default(uuid())
  vehicleId  String
  task       String
  intervalKm Int?
  dueDate    DateTime?
  lastDoneAt DateTime?
  createdAt  DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model Alert {
  id          String    @id @default(uuid())
  vehicleId   String
  label       String
  dueKm       Int?
  dueAt       DateTime?
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model Shop {
  id                 String             @id @default(uuid())
  userId             String             @unique
  name               String
  address            String
  city               String
  lat                Float?
  lng                Float?
  specialties        Json?
  verificationStatus VerificationStatus @default(pending)
  ratingAvg          Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  services     Service[]
}

model Store {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  address   String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  products Product[]
}

model Product {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int?     @default(0)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store            @relation(fields: [storeId], references: [id])
  compat ProductVehicle[]
  lines  OrderLine[]

  @@index([storeId])
}

model ProductVehicle {
  id        String  @id @default(uuid())
  productId String
  vehicleId String
  product   Product @relation(fields: [productId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([productId, vehicleId])
}

model Appointment {
  id          String            @id @default(uuid())
  vehicleId   String
  shopId      String
  ownerId     String
  scheduledAt DateTime
  status      AppointmentStatus @default(pending)
  summary     String?
  createdAt   DateTime          @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])
  owner   User    @relation("appointment_owner", fields: [ownerId], references: [id])

  @@index([shopId, scheduledAt])
}

model Service {
  id            String   @id @default(uuid())
  vehicleId     String
  shopId        String
  appointmentId String?
  description   String
  cost          Decimal? @db.Decimal(10, 2)
  photos        Json?
  status        String   @default("done")
  createdAt     DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])

  @@index([vehicleId])
}

model Order {
  id         String      @id @default(uuid())
  orderType  OrderType
  fromUserId String
  toShopId   String?
  toStoreId  String?
  status     OrderStatus @default(requested)
  createdAt  DateTime    @default(now())

  fromUser User        @relation("order_from", fields: [fromUserId], references: [id])
  toUser   User?       @relation("order_to", fields: [toStoreId], references: [id])
  lines    OrderLine[]

  @@index([fromUserId])
}

model OrderLine {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  itemName  String
  qty       Int      @default(1)
  unitPrice Decimal? @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Conversation {
  id        String    @id @default(uuid())
  userAId   String
  userBId   String?
  agent     Boolean   @default(false)
  createdAt DateTime  @default(now())
  messages  Message[]

  userA User  @relation("ConversationUserA", fields: [userAId], references: [id])
  userB User? @relation("ConversationUserB", fields: [userBId], references: [id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  from           String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  plan      String
  startsAt  DateTime @default(now())
  expiresAt DateTime
  active    Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  amount    Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Rating {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}
