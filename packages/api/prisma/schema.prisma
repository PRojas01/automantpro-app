// AutoMantPro — Prisma schema (MySQL 8)
// Source of truth for packages/api; original mirror in packages/db (PostgreSQL, legacy).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  dueno
  taller
  almacen
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}

enum OrderType {
  service
  repuesto
}

enum OrderStatus {
  requested
  accepted
  fulfilled
  cancelled
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageType {
  text
  audio
  image
  button
  location
  document
  video
  sticker
  reaction
  contacts
  unknown
}

enum LlmOutcome {
  ok
  fallback
  error
}

enum DiagnosticOutcome {
  confirmed
  partial
  incorrect
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String   @unique
  passwordHash String
  role         Role
  name         String
  locale       String   @default("es")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  vehicles       Vehicle[]
  shop           Shop?
  store          Store?
  appointments   Appointment[] @relation("appointment_owner")
  ordersFrom     Order[]       @relation("order_from")
  ordersTo       Order[]       @relation("order_to")
  conversationsA Conversation[] @relation("ConversationUserA")
  conversationsB Conversation[] @relation("ConversationUserB")
  subscriptions  Subscription[]
  transactions   Transaction[]
}

model Vehicle {
  id          String @id @default(uuid())
  userId      String
  make        String
  model       String
  year        Int
  currentKm   Int
  plan        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user         User             @relation(fields: [userId], references: [id])
  schedules    ServiceSchedule[]
  services     Service[]
  appointments Appointment[]
  alerts       Alert[]
  compat       ProductVehicle[]

  @@index([userId])
}

model ServiceSchedule {
  id         String    @id @default(uuid())
  vehicleId  String
  task       String
  intervalKm Int?
  dueDate    DateTime?
  lastDoneAt DateTime?
  createdAt  DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
}

model Alert {
  id          String    @id @default(uuid())
  vehicleId   String
  label       String
  dueKm       Int?
  dueAt       DateTime?
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
}

model Shop {
  id                  String             @id @default(uuid())
  userId              String             @unique
  name                String
  address             String
  city                String
  lat                 Float?
  lng                 Float?
  specialties         Json?
  verificationStatus  VerificationStatus @default(pending)
  ratingAvg           Float              @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  services     Service[]
}

model Store {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  address   String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  products Product[]
}

model Product {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int?     @default(0)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store             @relation(fields: [storeId], references: [id])
  compat ProductVehicle[]
  lines  OrderLine[]

  @@index([storeId])
}

model ProductVehicle {
  id        String    @id @default(uuid())
  productId String
  vehicleId String
  product   Product   @relation(fields: [productId], references: [id])
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

  @@unique([productId, vehicleId])
}

model Appointment {
  id          String            @id @default(uuid())
  vehicleId   String
  shopId      String
  ownerId     String
  scheduledAt DateTime
  status      AppointmentStatus @default(pending)
  summary     String?
  createdAt   DateTime          @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])
  owner   User    @relation("appointment_owner", fields: [ownerId], references: [id])

  @@index([shopId, scheduledAt])
}

model Service {
  id            String   @id @default(uuid())
  vehicleId     String
  shopId        String
  appointmentId String?
  description   String   @db.Text
  cost          Decimal? @db.Decimal(10, 2)
  photos        Json?
  status        String   @default("done")
  createdAt     DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])
  @@index([vehicleId])
}

model Order {
  id         String      @id @default(uuid())
  orderType  OrderType
  fromUserId String
  toShopId   String?
  toStoreId  String?
  status     OrderStatus @default(requested)
  createdAt  DateTime    @default(now())

  fromUser User        @relation("order_from", fields: [fromUserId], references: [id])
  toUser   User?       @relation("order_to", fields: [toStoreId], references: [id])
  lines    OrderLine[]
  @@index([fromUserId])
}

model OrderLine {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  itemName  String
  qty       Int      @default(1)
  unitPrice Decimal? @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

// --- S1-18: memoria y contexto (§10 docs/31) ---
model Session {
  id        String   @id @default(uuid())
  userId    String
  role      Role     @default(dueno)
  flow      String?
  step      String?
  data      Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, role])
}

model Conversation {
  id        String    @id @default(uuid())
  userAId   String
  userBId   String?
  agent     Boolean   @default(false)
  summary   String?   @db.Text
  turnCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages Message[]
  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB    User?     @relation("ConversationUserB", fields: [userBId], references: [id])

  @@index([userAId, updatedAt])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  wamid          String?          @unique
  from           String
  direction      MessageDirection @default(incoming)
  type           MessageType      @default(text)
  body           String?          @db.Text
  payload        Json?
  costUsd        Decimal?         @db.Decimal(10, 6)
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

// --- S1-17: registro y trazabilidad (§7 docs/31) ---
model Event {
  id          String   @id @default(uuid())
  type        String
  actorUserId String?
  actorRole   Role?
  entityType  String?
  entityId    String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([actorUserId])
}

model AuditLog {
  id          String   @id @default(uuid())
  eventType   String
  actorUserId String?
  actorRole   Role?
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

model ToolCall {
  id              String   @id @default(uuid())
  conversationId  String?
  agent           String
  tool            String
  args            Json?
  resultStatus    String
  durationMs      Int      @default(0)
  confirmedByUser Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([tool])
}

model LlmUsage {
  id            String     @id @default(uuid())
  agent         String
  function      String
  provider      String
  model         String
  promptVersion String?
  inputTokens   Int        @default(0)
  outputTokens  Int        @default(0)
  cachedTokens  Int        @default(0)
  costUsd       Decimal?   @db.Decimal(10, 6)
  latencyMs     Int?
  outcome       LlmOutcome @default(ok)
  createdAt     DateTime   @default(now())

  @@index([createdAt])
  @@index([agent])
}

// --- S1-17: retroalimentación (§8 docs/31) ---
model PromptVersion {
  id          String    @id @default(uuid())
  agent       String
  version     String
  textHash    String?   @unique
  evalScore   Float?
  publishedAt DateTime?
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([agent, version])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  target    String
  score     Int
  comment   String?  @db.Text
  sentiment String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([score])
}

model DiagnosisOutcome {
  id          String             @id @default(uuid())
  diagnosisId String
  workOrderId String?
  outcome     DiagnosticOutcome
  realCause   String?            @db.Text
  createdAt   DateTime           @default(now())

  @@index([diagnosisId])
}

model Subscription {
  id         String   @id @default(uuid())
  userId     String
  plan       String
  startsAt   DateTime @default(now())
  expiresAt  DateTime
  active     Boolean  @default(true)

  user   User   @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  amount    Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Rating {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}